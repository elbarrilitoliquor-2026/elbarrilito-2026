# ============================================================
# SUPABASE CONFIG — El Barrilito React site
# Fill these two values in from your Supabase project:
# Dashboard → Project Settings → API
#
# IMPORTANT: This must point to the SAME Supabase project used by the
# admin panel's js/supabase-config.js (../js/supabase-config.js), so
# products/reviews/whatsapp_clicks edited in one place show up in both.
# ============================================================

VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
