# ============================================================
# SUPABASE CONFIG — El Barrilito Admin Panel (React)
# Fill these two values in from your Supabase project:
# Dashboard → Project Settings → API
#
# IMPORTANT: This must point to the SAME Supabase project used by
# ../js/supabase-config.js (vanilla admin panel) and ../web-react/.env
# (customer React site), so products/reviews/whatsapp_clicks edited in
# one place show up in all of them.
# ============================================================

VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
