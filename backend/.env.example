# ============================================================
# SUPABASE CONFIG — El Barrilito Backend API
#
# Dashboard → Project Settings → API
#
# IMPORTANT: This must point to the SAME Supabase project used by
# ../js/supabase-config.js, ../web-react/.env, and
# ../web-react-admin/.env, so products/reviews/whatsapp_clicks stay
# consistent everywhere.
# ============================================================

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# SERVICE ROLE key — Project Settings → API → service_role secret.
# This is NOT the same as the anon/public key used by the frontends.
# It bypasses Row Level Security entirely (full DB read/write).
#
# NEVER commit this value. NEVER expose it to any frontend/browser
# bundle. It must only ever live in this backend's server-side
# environment (this .env file, or your host's secret manager).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY

# Port this API listens on.
PORT=5000

# Comma-separated list of origins allowed to call this API (CORS).
# Defaults to the two Vite dev servers in this repo if unset:
#   web-react       -> http://localhost:4173
#   web-react-admin -> http://localhost:4176
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:4176
